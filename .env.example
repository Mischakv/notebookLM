# ---------------------------------------------------------------------------
# Supabase. Both are public by design; RLS is the security boundary, not the key.
# `pnpm supabase start` prints these for a local stack; a hosted project has them
# under Project Settings > API.
#
# The client key goes under whichever name matches your project: newer projects
# issue `sb_publishable_...`, older ones an `anon` JWT. Either variable works; set
# one. Both need the NEXT_PUBLIC_ prefix or the browser never sees them.
#
# This app never uses a service-role / `sb_secret_...` key. Do not add one.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Embeddings
#
# PICK ONE BEFORE INGESTING ANYTHING. The pgvector column has a fixed dimension,
# so switching later requires re-ingesting every source.
#
#   local     Supabase Edge Function `embed` using the runtime's built-in
#             gte-small model. 384 dims, no API key, no cost.
#   external  Any OpenAI-compatible /embeddings endpoint. 1536 dims by default.
#             Also copy supabase/migrations-external/0004_embeddings_external.sql
#             into supabase/migrations/ before applying anything.
# ---------------------------------------------------------------------------
EMBEDDING_STRATEGY=local

# Only when EMBEDDING_STRATEGY=external. OpenRouter does not serve embeddings,
# so this is a separate config from the chat provider below.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Chat — server fallback
#
# Optional. Used when the visitor has not configured their own provider in
# Settings, so they can try the app without a provider account. Limited to 20
# messages per user per day.
#
# IF YOU SET THIS, SET A HARD SPEND CAP IN YOUR PROVIDER DASHBOARD. The daily
# counter limits messages, not tokens, and is not a billing control.
#
# Never expose any of these as NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
DEFAULT_CHAT_MODEL=
# Optional; defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
